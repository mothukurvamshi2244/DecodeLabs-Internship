    "# Sort orders by TotalPrice\n",
    "\n",
    "top_orders = df.sort_values(\n",
    "    by=\"TotalPrice\",\n",
    "    ascending=False\n",
    ").head(10)\n",
    "\n",
    "top_orders[[\n",
    "    \"OrderID\",\n",
    "    \"Product\",\n",
    "    \"Quantity\",\n",
    "    \"UnitPrice\",\n",
    "    \"TotalPrice\",\n",
