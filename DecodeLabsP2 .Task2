   "source": [
    "# Find outlier records\n",
    "\n",
    "outliers = df[\n",
    "    (df[\"TotalPrice\"] < lower_limit) |\n",
    "    (df[\"TotalPrice\"] > upper_limit)\n",
    "]\n",
    "\n",
    "print(\"Number of outliers:\", len(outliers))\n",
    "\n",
    "outliers.head()"
   ]
  },
  {
