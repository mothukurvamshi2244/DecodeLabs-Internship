   "source": [
    "# Create scatter plot\n",
    "\n",
    "plt.figure(figsize=(8, 5))\n",
    "\n",
    "plt.scatter(df[\"Quantity\"], df[\"TotalPrice\"])\n",
    "\n",
    "plt.title(\"Relationship Between Quantity and Total Price\")\n",
    "plt.xlabel(\"Quantity\")\n",
    "plt.ylabel(\"Total Price\")\n",
    "\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
