   "source": [
    "# Create histogram for analyzing Quantity distribution\n",
    "\n",
    "plt.figure(figsize=(8, 5))\n",
    "\n",
    "plt.hist(df[\"Quantity\"], bins=10)\n",
    "\n",
    "plt.title(\"Distribution of Order Quantity\")\n",
    "plt.xlabel(\"Quantity\")\n",
    "plt.ylabel(\"Number of Orders\")\n",
    "\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
