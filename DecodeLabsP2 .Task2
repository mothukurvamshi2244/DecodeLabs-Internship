   "source": [
    "# Select numerical columns\n",
    "\n",
    "numeric_data = df[[\"Quantity\", \"UnitPrice\", \"ItemsInCart\", \"TotalPrice\"]]\n",
    "\n",
    "# Calculate correlation\n",
    "\n",
    "correlation = numeric_data.corr()\n",
    "\n",
    "print(correlation)"
   ]
  },
